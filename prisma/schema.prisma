generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  type         String
  bank         String
  balance      Int
  color        String        @default("#6366f1")
  hidden       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  emoji        String        @default("📌")
  transactions Transaction[]
  rules        Rule[]
}

model Rule {
  id         Int      @id @default(autoincrement())
  // Stored as entered (casing preserved); compared case-insensitively.
  // A case-insensitive UNIQUE index (COLLATE NOCASE) is added in the migration.
  match      String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Transaction {
  id           Int      @id @default(autoincrement())
  date         DateTime
  description  String
  note         String?
  amount       Int
  accountId    Int
  categoryId   Int
  familiar     String?
  isReimbursed Boolean  @default(false)
  // True when the category was set by hand through the app — the evidence the
  // rule-suggestion engine mines. Backfilled true for pre-existing non-"Otro"
  // transactions that match no rule (which can only have come from a manual edit).
  manuallySet  Boolean  @default(false)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
}

// A suggestion the user dismissed, keyed exactly on its (match, categoryId) so
// it is never proposed again. v1 uses exact keying; a drifted LCS-derived match
// may reappear once (accepted trade-off).
model DismissedSuggestion {
  id         Int      @id @default(autoincrement())
  match      String
  categoryId Int
  createdAt  DateTime @default(now())

  @@unique([match, categoryId])
}
