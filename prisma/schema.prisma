generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  type         String
  bank         String
  balance      Int
  color        String        @default("#6366f1")
  hidden       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  emoji        String        @default("📌")
  transactions Transaction[]
  rules        Rule[]
}

model Rule {
  id         Int      @id @default(autoincrement())
  // Stored as entered (casing preserved for display) but compared
  // case-insensitively. The unique index below uses COLLATE NOCASE.
  match      String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Transaction {
  id           Int      @id @default(autoincrement())
  date         DateTime
  description  String
  note         String?
  amount       Int
  accountId    Int
  categoryId   Int
  isShared     Boolean  @default(false)
  isReimbursed Boolean  @default(false)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
}
