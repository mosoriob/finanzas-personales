generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  type         String
  bank         String
  balance      Int
  color        String        @default("#6366f1")
  hidden       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  pendingSyncTransactions PendingSyncTransaction[]
  rejectedDuplicates RejectedDuplicate[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  emoji        String        @default("📌")
  // Excluded categories (e.g. "Movimiento interno") never contribute to any
  // statistic — see src/lib/stats-exclusion.ts. Rows stay visible in the
  // transactions list and the category remains selectable.
  excluded     Boolean       @default(false)
  transactions Transaction[]
  rules        Rule[]
}

model Rule {
  id         Int      @id @default(autoincrement())
  // Stored as entered (casing preserved); compared case-insensitively.
  // A case-insensitive UNIQUE index (COLLATE NOCASE) is added in the migration.
  match      String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Transaction {
  id           Int      @id @default(autoincrement())
  date         DateTime
  description  String
  note         String?
  amount       Int
  // Native currency of the amount. null (absent) means CLP, mirroring the
  // scraper's convention; "USD" marks a dollar-billed charge. Only "USD" or
  // null are ever written (application-level invariant; SQLite has no enum).
  // USD amounts are stored natively (no FX conversion) and excluded from peso
  // aggregates via isCLP().
  currency     String?
  accountId    Int
  categoryId   Int
  familiar     String?
  isReimbursed Boolean  @default(false)
  // True when the category was set by hand through the app — the evidence the
  // rule-suggestion engine mines. Backfilled true for pre-existing non-"Otro"
  // transactions that match no rule (which can only have come from a manual edit).
  manuallySet  Boolean  @default(false)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
}

// A scraped movement that looks like a possible date-drift duplicate: it matches
// an existing transaction on (amount, accountId, currency) with a date drifted
// ≤3 days, so instead of importing it the sync stages it here for human review.
// It is NOT a real transaction and never contributes to any aggregate until the
// user accepts it. `candidateId` is a LOOSE integer with no foreign key — it
// points at the existing transaction this movement might duplicate, but deleting
// that candidate must not cascade-delete the suspect (the suspect stays
// reviewable and acceptable on its own). `accountId` cascades on account delete.
// The (accountId, amount, currency, date) unique index is a backstop against
// double-queuing; note SQLite treats each NULL currency as distinct, so it does
// NOT dedupe CLP (null-currency) rows — the application-level check in the sync
// route is the real guard.
model PendingSyncTransaction {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  amount      Int
  currency    String?
  accountId   Int
  categoryId  Int
  candidateId Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([accountId, amount, currency, date])
  @@index([accountId])
}

// A durable "these are the same charge" memory written when a user rejects a
// suspected date-drift duplicate. Keyed on the STABLE fields
// (accountId, amount, currency, date), where `date` is the rejected movement's
// own (now-stable, settled) date. It carries NO reference to the candidate — the
// memory is purely "a movement matching these fields within ±3 days of this date
// is a known duplicate; silently skip it". The sync ladder checks this memory
// after exact-match but BEFORE fuzzy queuing, or a rejected duplicate would
// re-queue forever. `accountId` cascades on account delete. Currency stays part
// of identity, so a USD charge never matches a same-amount CLP rejection.
model RejectedDuplicate {
  id         Int      @id @default(autoincrement())
  date       DateTime
  amount     Int
  currency   String?
  accountId  Int
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([accountId])
}

// A suggestion the user dismissed, keyed exactly on its (match, categoryId) so
// it is never proposed again. v1 uses exact keying; a drifted LCS-derived match
// may reappear once (accepted trade-off).
model DismissedSuggestion {
  id         Int      @id @default(autoincrement())
  match      String
  categoryId Int
  createdAt  DateTime @default(now())

  @@unique([match, categoryId])
}
